# Copy to .env and fill in only the keys you need. .env is git-ignored; never commit keys.
ROBOFLOW_API_KEY=
HF_TOKEN=
FREESOUND_API_KEY=
# Kaggle: new-style API token (from kaggle.com/settings -> API). Older accounts use KAGGLE_USERNAME + KAGGLE_KEY instead.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
# data.gov: only needed for its search APIs; plain downloads need no key
DATA_GOV_API_KEY=
